# ==========================================
# HisabDo Web Application - Environment Variables
# ==========================================

# JWT Authentication Secret (Required for Jose JWT token signing)
JWT_SECRET=hisabdo_jwt_secret_key_2026_production_safe_string_32chars

# Public API URL Base
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Optional: Supabase Configuration (if cloud database sync is enabled)
NEXT_SUPABASE_URL=
NEXT_SUPABASE_ANON_KEY=

# Optional: NextAuth compatibility
NEXTAUTH_SECRET=hisabdo_nextauth_secret_key_2026
NEXTAUTH_URL=http://localhost:3000
